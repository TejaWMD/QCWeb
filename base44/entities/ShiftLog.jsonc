{
  "name": "ShiftLog",
  "type": "object",
  "properties": {
    "shift_date": {
      "type": "string",
      "format": "date"
    },
    "shift_type": {
      "type": "string",
      "enum": [
        "Morning",
        "Night"
      ],
      "default": "Morning"
    },
    "production_line": {
      "type": "string"
    },
    "task": {
      "type": "string",
      "enum": [
        "Carton Packing",
        "Automatic Machine Filling",
        "Production Planning",
        "Packaging Supervisor",
        "Inventory Checker",
        "Apply sticker",
        "Put Cap (Babu Machine)",
        "Manual Filling & Capping"
      ]
    },
    "task_filled_packed": {
      "type": "boolean",
      "default": false
    },
    "task_capped": {
      "type": "boolean",
      "default": false
    },
    "task_label_applied": {
      "type": "boolean",
      "default": false
    },
    "task_carton_packed": {
      "type": "boolean",
      "default": false
    },
    "task_packed_in_container": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete"
      ],
      "default": "incomplete"
    },
    "product_type": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "batch_number": {
      "type": "string"
    },
    "planned_cartons": {
      "type": "number",
      "default": 0
    },
    "pcs_per_carton": {
      "type": "number",
      "default": 0
    },
    "planned_qty": {
      "type": "number",
      "default": 0
    },
    "actual_output": {
      "type": "number",
      "default": 0
    },
    "rejected_qty": {
      "type": "number",
      "default": 0
    },
    "bottle_used": {
      "type": "number",
      "default": 0
    },
    "bottle_waste": {
      "type": "number",
      "default": 0
    },
    "jar_used": {
      "type": "number",
      "default": 0
    },
    "jar_waste": {
      "type": "number",
      "default": 0
    },
    "plastic_used": {
      "type": "number",
      "default": 0
    },
    "plastic_waste": {
      "type": "number",
      "default": 0
    },
    "pouch_used": {
      "type": "number",
      "default": 0
    },
    "pouch_waste": {
      "type": "number",
      "default": 0
    },
    "foil_used": {
      "type": "number",
      "default": 0
    },
    "foil_waste": {
      "type": "number",
      "default": 0
    },
    "cup_used": {
      "type": "number",
      "default": 0
    },
    "cup_waste": {
      "type": "number",
      "default": 0
    },
    "tub_used": {
      "type": "number",
      "default": 0
    },
    "tub_waste": {
      "type": "number",
      "default": 0
    },
    "cap_used": {
      "type": "number",
      "default": 0
    },
    "cap_waste": {
      "type": "number",
      "default": 0
    },
    "lid_used": {
      "type": "number",
      "default": 0
    },
    "lid_waste": {
      "type": "number",
      "default": 0
    },
    "packet_used": {
      "type": "number",
      "default": 0
    },
    "packet_waste": {
      "type": "number",
      "default": 0
    },
    "shrink_label_used": {
      "type": "number",
      "default": 0
    },
    "shrink_label_waste": {
      "type": "number",
      "default": 0
    },
    "label_used": {
      "type": "number",
      "default": 0
    },
    "label_waste": {
      "type": "number",
      "default": 0
    },
    "extra_sticker_used": {
      "type": "number",
      "default": 0
    },
    "extra_sticker_waste": {
      "type": "number",
      "default": 0
    },
    "carton_box_used": {
      "type": "number",
      "default": 0
    },
    "carton_box_waste": {
      "type": "number",
      "default": 0
    },
    "staff_count": {
      "type": "number",
      "default": 1
    },
    "staff_name": {
      "type": "string"
    },
    "staff_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "break_duration": {
      "type": "number",
      "default": 1
    },
    "ot_duration_hours": {
      "type": "number",
      "default": 0
    },
    "hourly_ot_rate": {
      "type": "number",
      "default": 12
    },
    "downtime_min": {
      "type": "number",
      "default": 0
    },
    "downtime_remarks": {
      "type": "string"
    },
    "session_id": {
      "type": "string",
      "description": "Shared session identifier linking this shift log to its Operation, Overtime and Wastage records"
    },
    "record_batch": {
      "type": "string",
      "enum": [
        "legacy",
        "current"
      ],
      "default": "current"
    },
    "access_scopes": {
      "type": "array",
      "description": "Modules that may read this record",
      "items": {
        "type": "string"
      },
      "default": [
        "shift_log",
        "dashboard",
        "overtime_record",
        "wastage_records",
        "activity_logs"
      ]
    }
  },
  "required": [
    "shift_date",
    "shift_type",
    "production_line"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.access_scopes": {
            "$in": "{{user.data.permissions}}"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}